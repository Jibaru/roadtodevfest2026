# Copy to .env and fill in. .env is gitignored.

# Gemini API key from https://aistudio.google.com/apikey (personal account!)
GEMINI_API_KEY=

# Any secret string; gates the /stage page and presenter endpoints.
PRESENTER_TOKEN=

# Your personal GCP project ID (set by scripts/setup.sh).
GCP_PROJECT=

# Cloud Run region.
GCP_REGION=us-central1
