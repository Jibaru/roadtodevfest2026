# Copy to .env and fill in. .env is gitignored.

# OpenAI API key from https://platform.openai.com/api-keys (personal account!)
OPENAI_API_KEY=
# gpt-6-luna (default, budget) or gpt-6-sol (mid-tier).
OPENAI_MODEL=gpt-6-luna

# Any secret string; gates the /stage page and presenter endpoints.
PRESENTER_TOKEN=

# Your personal GCP project ID (set by scripts/setup.sh).
GCP_PROJECT=

# Cloud Run region.
GCP_REGION=us-central1
